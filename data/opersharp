


func start() {
    matrix cell m(2, 3);
    cell f <- (right);
    cell s <- (down, top);
    cell t <- (left);
    cell sf <- (top, down);
    cell ss <- (left,right);
    cell st <- (left);

    m(0,0) <- f;
    m(0,1) <- s;
    m(0, 2) <- t;
    m(1,0) <- sf;
    m(1,1) <- ss;
    m(1, 2) <- st;
    printvar m;
    matrix cell j;
    j <- #m;
    printvar j;

}