func isFork(cell c) {
    signed res <- 0;
    signed ch <- c*lC;
    testonce(ch = 0) {
        res <- res+1;
    }
    ch <- c*rC;
    testonce(ch= 0) {
        res <- res+1;
    }
    ch <- c*dC;
    testonce(ch = 0) {
        res <- res+1;
    }
    ch <- c*tC;
    testonce(ch= 0) {
       res <- res+1;
    }
    res > 2;
}


